# =================================================================
# EXPLORIA: configuration lives in backend/.env
# =================================================================
# Both the local dev setup and docker-compose.yml read backend/.env.
# Copy backend/.env.example to backend/.env and fill in your keys:
#
#   cp backend/.env.example backend/.env
#
# The frontend needs no keys: it calls /api on its own origin
# (proxied by Vite in development and by Nginx in Docker).
