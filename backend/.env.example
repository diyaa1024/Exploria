# ==========================================
# EXPLORIA BACKEND CONFIGURATION
# ==========================================

# AI text generation tries providers in order: Groq -> OpenRouter -> Gemini -> built-in text.
# Any provider left blank is skipped.

# Groq API Key (Recommended primary: fastest generation)
# Free, no credit card: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter API Key (Optional extra fallback): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b

# Google Gemini API Key (Backup generator; also used for embeddings)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (defaults to gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-1.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/text-embedding-004

# Google Maps API Key (Optional: for Google Maps JS API & Google Geocoding)
# If left blank, Exploria automatically uses OpenStreetMap & Nominatim (100% free, no credit card required)
GOOGLE_MAPS_API_KEY=

# Foursquare Places API Key (Optional: for restaurant enrichment)
# If left blank, Exploria automatically uses OpenStreetMap culinary registry
FOURSQUARE_API_KEY=

# Geoapify Places API Key (Optional but recommended: nearby food & tourist spots)
# Free, no credit card: https://myprojects.geoapify.com (3,000 credits/day)
# Used when no Google key is set; gives real venues + distances (no ratings).
GEOAPIFY_API_KEY=

# Cache Settings (Disk-based cache to conserve free tier quotas)
CACHE_TTL_HOURS=168
CACHE_PRECISION_DECIMALS=3
